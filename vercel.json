{
  "rewrites": [
    {
      "source": "/drafthon/",
      "destination": "/drafthon/index.html"
    },
    {
      "source": "/drafthon/binkan/",
      "destination": "/drafthon/binkan/index.html"
    },
    {
      "source": "/((?!api/|drafthon/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/drafthon/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "functions": {
    "api/drafthon-ai.js": {
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/drafthon/binkan",
      "destination": "/drafthon/binkan/",
      "permanent": false
    },
    {
      "source": "/drafthon",
      "destination": "/drafthon/",
      "permanent": false
    }
  ]
}
